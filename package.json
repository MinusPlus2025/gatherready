{
  "name": "gatherready",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GatherReady \u2014 turn conditional workshop interest into one plan everyone agrees to, then fund it with a real PayPal sandbox authorization.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsx scripts/verify.ts",
    "setup": "node scripts/setup-access.mjs",
    "preflight": "tsx scripts/preflight.ts",
    "ai-eval": "tsx scripts/ai-eval.ts",
    "capture-shots": "tsx scripts/capture-shots.ts",
    "seed": "tsx scripts/seed.ts",
    "sandbox-spine": "tsx scripts/sandbox-spine.ts",
    "capture-live": "tsx scripts/capture-live.ts",
    "record-demo": "tsx scripts/record-demo.ts",
    "paypal-preflight": "tsx scripts/paypal-preflight.ts",
    "test:ui": "tsx scripts/ui-smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.0",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
