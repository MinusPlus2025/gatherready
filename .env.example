# GatherReady — copy to .env.local or run `npm run setup`.
# Secrets are NEVER committed. Sandbox only.

# PayPal Sandbox REST app (Dashboard -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Public buyer-side client id for the PayPal JS SDK (same sandbox app id; optional)
VITE_PAYPAL_CLIENT_ID=

# Hosted model. OpenAI-compatible or Gemini. Optional: without it the app runs in
# Structured baseline mode (no live model) and says so in the UI.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_CALLS_PER_DAY=400

# Server
PORT=5180
PUBLIC_BASE_URL=http://localhost:5180
GATHERREADY_DB=data/gatherready.db
